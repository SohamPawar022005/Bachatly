# ---------------------------------------------------------------------------
# Bachatly environment variables
# Copy to `.env` and fill in. Every optional service degrades gracefully:
# the app boots and runs with only DATABASE_URL + AUTH_SECRET set.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Neon / local PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/bachatly?schema=public"
# Direct connection (used by Prisma migrate). Same value is fine for local dev.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/bachatly?schema=public"

# --- Auth (required) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Absolute URL of the app (used for canonical URLs + emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Data layer ------------------------------------------------------------
# "prisma" (default, uses Prisma Client + @prisma/adapter-pg) or "pg"
# (plain node-postgres pool; used automatically when a Prisma Client build is
#  unavailable, e.g. offline environments where engines cannot be downloaded).
BACHATLY_DB_ADAPTER=""

# --- Redis / queues (optional) ---------------------------------------------
# Upstash or self-hosted Redis. Without it, jobs run in-process / manually.
REDIS_URL=""
BULLMQ_QUEUE_NAME="bachatly-jobs"
# Cron for the scheduled price-refresh worker (BullMQ repeatable job)
PRICE_UPDATE_CRON="*/30 * * * *"

# --- Email (optional) ------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Bachatly <alerts@bachatly.app>"

# --- Image storage (optional) ----------------------------------------------
CLOUDINARY_URL=""

# --- Monitoring / analytics (optional) -------------------------------------
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"

# --- Demo data -------------------------------------------------------------
# Seed script uses this to label data sources as DEMO. Keep "true" unless you
# connect a real, authorized retailer feed.
BACHATLY_DEMO_DATA="true"

# --- Seeded demo accounts (only used by prisma/seed.ts) --------------------
SEED_ADMIN_EMAIL="admin@bachatly.app"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_USER_EMAIL="demo@bachatly.app"
SEED_USER_PASSWORD="Demo@12345"
