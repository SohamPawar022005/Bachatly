{
  "name": "bachatly",
  "version": "0.1.0",
  "private": true,
  "description": "Bachatly — Compare. Save. Buy Smart. Full-stack price comparison platform.",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "prisma generate --no-hints || true; next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "tsx scripts/db-local.ts up",
    "db:down": "tsx scripts/db-local.ts down",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "jobs:worker": "tsx jobs/worker.ts",
    "jobs:price-update": "tsx jobs/run-price-update.ts",
    "jobs:alert-check": "tsx jobs/run-alert-check.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.74.0",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.545.0",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.16.3",
    "posthog-js": "^1.430.3",
    "posthog-node": "^5.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "recharts": "^3.10.1",
    "resend": "^6.5.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.25",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17"
  }
}